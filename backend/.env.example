# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# SQLite works with zero setup for local/dev. Point at Postgres in Docker/production:
# DATABASE_URL=postgresql://docurag:docurag@postgres:5432/docurag
DATABASE_URL=sqlite:///./docurag.db

# --- Storage ---
UPLOAD_DIR=./storage/uploads
VECTOR_DB_DIR=./storage/vectordb
MAX_UPLOAD_SIZE_MB=50

# --- Embeddings (EMBEDDING_PROVIDER=local requires no API key; needs internet
#     to download the model the first time it runs) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Reranker ---
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...          # free tier: https://aistudio.google.com/apikey — no credit card required
# GEMINI_MODEL=gemini-2.5-flash

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_CONTEXT_CHUNKS=8

# --- Hybrid retrieval ---
RETRIEVAL_CANDIDATES=25
RERANK_TOP_K=6
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4

# --- Grounding ---
MIN_GROUNDING_SCORE=0.35

# --- CORS (comma-separated list is NOT supported by pydantic list parsing via
#     .env directly; edit app/core/config.py CORS_ORIGINS default if needed) ---
